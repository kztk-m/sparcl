-- It is intentional that this program causes an error.
-- `{{e}}` can be written only as an argument of an application (`f {{e}}`),
-- not as the body of a definition: a parse error.

data Nat = Z | S Nat

class Eq a where
    sig (==) : a -> a -> Bool
end

instance eqNat : Eq Nat where
    def (==) Z     Z     = True
           | (S n) (S m) = n == m
           | _     _     = False
end

def d = {{eqNat}}
