-- It is intentional that this program causes a type error.
-- The instance argument `{{Eq a}}` comes after the written patterns of `f`,
-- so `go` in `where` cannot use it (writing `def f x {{_}}` fixes this).

data Nat = Z | S Nat

class Eq a where
    sig (==) : a -> a -> Bool
end

instance eqNat : Eq Nat where
    def (==) Z     Z     = True
           | (S n) (S m) = n == m
           | _     _     = False
end

sig f : a -> {{Eq a}} -> Bool
def f x = go
    where
        def go = x == x
    end
