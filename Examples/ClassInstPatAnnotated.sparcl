-- Instance patterns `{{d}}` whose type is given by a signature or an
-- annotation.

data Nat = Z | S Nat

class Eq a where
    sig (==) : a -> a -> Bool
end

instance eqNat : Eq Nat where
    def (==) Z     Z     = True
           | (S n) (S m) = n == m
           | _     _     = False
end

-- A local `def` with a signature
sig t1 : Bool
def t1 = let sig same : {{Eq a}} -> a -> Bool
             def same {{d}} x = x == x
         in same (S Z)

-- An expression annotation with an explicit `forall`
sig t2 : Bool
def t2 = ((\{{d}} x -> x == x) : forall a. {{Eq a}} -> a -> Bool) Z

-- An expression annotation with a monotype.
sig t3 : Bool
def t3 = ((\{{d}} x y -> x == y) : {{Eq Nat}} -> Nat -> Nat -> Bool) Z (S Z)

-- Expected values

def t1' = True
def t2' = True
def t3' = False
