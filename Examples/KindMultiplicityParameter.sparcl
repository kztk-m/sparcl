-- Kind inference of a parameter: p is the first argument of Many, so it is
-- inferred to be a multiplicity (M : Multiplicity -> Type). Many is a
-- built-in type constructor and can be written as a type.
-- See also Nonexamples_Illtyped/KindMultiplicityParameter.sparcl.

data M p = MkM (Many p Int)

sig unM : M p -> Many p Int
def unM (MkM m) = m
